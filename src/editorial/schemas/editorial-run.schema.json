{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Editorial Run Manifest",
  "type": "object",
  "properties": {
    "runId": { "type": "string" },
    "sourceId": { "type": "string" },
    "page": { "type": "integer" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": { "enum": ["pending", "skipped", "succeeded", "failed", "blocked"] },
          "startedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": "string", "format": "date-time" },
          "error": { "type": "string" }
        }
      }
    }
  },
  "required": ["runId", "sourceId", "page", "startedAt"]
}
