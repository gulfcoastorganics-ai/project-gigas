{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manuscript Line",
  "type": "object",
  "properties": {
    "lineId": { "type": "string" },
    "sourceId": { "type": "string" },
    "page": { "type": "integer" },
    "regionId": { "type": "string" },
    "lineNumber": { "type": "integer" },
    "boundingBox": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "readingOrder": { "type": "integer" },
    "reviewState": { "type": "string" }
  },
  "required": ["lineId", "sourceId", "page", "regionId", "lineNumber", "boundingBox", "readingOrder"]
}
